<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Demo_btl_10_10.Site" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#346c43" />
    <title>MyCamp</title>
    <link href="Content/Site.css" rel="stylesheet" type="text/css" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <%-- Bộ biểu tượng dùng chung cho header --%>
    <svg width="0" height="0" style="position: absolute" aria-hidden="true" focusable="false">
        <symbol id="i-menu" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18" /></symbol>
        <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></symbol>
        <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 4-6 8-6s8 2 8 6" /></symbol>
        <symbol id="i-cart" viewBox="0 0 24 24"><circle cx="9" cy="20" r="1.5" /><circle cx="18" cy="20" r="1.5" /><path d="M2 3h3l2.7 12.4a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6" /></symbol>
        <symbol id="i-close" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" /></symbol>
        <symbol id="i-chevron" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" /></symbol>
        <symbol id="i-tent" viewBox="0 0 24 24"><path d="M12 3L2 20h20L12 3z" /><path d="M12 20l-3.5-6h7L12 20z" /></symbol>
    </svg>

    <form id="form1" runat="server">
        <header class="site-header">

            <%-- Thanh trên cùng (chỉ hiện trên máy tính) --%>
            <div class="topbar">
                <div class="container topbar-inner">
                    <div class="topbar-links">
                        <a href="tel:0987654321">0987654321</a>
                        <a href="mailto:hotro@Mycamp.vn">hotro@Mycamp.vn</a>
                    </div>
                    <div class="topbar-links">
                        <% if (IsLoggedIn) { %>
                        <span class="hello">Xin chào, <%: DisplayName %></span>
                        <% if (IsAdmin) { %><a href="Admin.aspx">Quản trị</a><% } %>
                        <a href="Login.aspx?logout=1">Đăng xuất</a>
                        <% } else { %>
                        <a href="SignUp.aspx">Đăng ký</a>
                        <a href="Login.aspx">Đăng nhập</a>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="header-sticky">
                <div class="header-main">
                    <div class="container header-main-inner">
                        <button type="button" class="nav-toggle" id="navToggle" aria-label="Mở menu" aria-controls="mainNav" aria-expanded="false">
                            <svg class="ico"><use href="#i-menu" /></svg>
                        </button>

                        <div class="logo">
                            <a href="Default.aspx"><svg class="ico"><use href="#i-tent" /></svg><span>MyCamp</span></a>
                        </div>

                        <div class="search-box" role="search">
                            <input type="text" id="searchInput" placeholder="Tìm kiếm sản phẩm..." autocomplete="off" />
                            <button type="button" id="searchBtn" title="Tìm kiếm" aria-label="Tìm kiếm"><svg class="ico"><use href="#i-search" /></svg></button>
                        </div>

                        <a class="cart-btn" href="Cart.aspx" aria-label="Giỏ hàng">
                            <svg class="ico"><use href="#i-cart" /></svg>
                            <span class="cart-label">Giỏ hàng</span>
                            <span class="cart-count" id="cartCount">0</span>
                        </a>
                    </div>
                </div>

                <%-- Lớp mờ phía sau menu trượt (mobile) --%>
                <div class="nav-overlay" id="navOverlay"></div>

                <nav class="main-nav" id="mainNav" aria-label="Menu chính">
                    <%-- Đầu menu trượt: thông tin tài khoản (chỉ hiện trên mobile) --%>
                    <div class="drawer-head">
                        <div class="drawer-user">
                            <svg class="ico"><use href="#i-user" /></svg>
                            <div>
                                <% if (IsLoggedIn) { %>
                                <strong>Xin chào, <%: DisplayName %></strong>
                                <div class="drawer-auth">
                                    <% if (IsAdmin) { %><a href="Admin.aspx">Quản trị</a><% } %>
                                    <a href="Login.aspx?logout=1">Đăng xuất</a>
                                </div>
                                <% } else { %>
                                <strong>Chào bạn!</strong>
                                <div class="drawer-auth">
                                    <a href="Login.aspx">Đăng nhập</a>
                                    <a href="SignUp.aspx">Đăng ký</a>
                                </div>
                                <% } %>
                            </div>
                        </div>
                        <button type="button" class="drawer-close" id="navClose" aria-label="Đóng menu">
                            <svg class="ico"><use href="#i-close" /></svg>
                        </button>
                    </div>

                    <div class="container main-nav-inner">
                        <ul class="nav-list">
                            <li class="nav-item"><a class="nav-link" href="Default.aspx">Trang chủ</a></li>

                            <li class="nav-item has-dropdown">
                                <a class="nav-link" href="Products.aspx">Sản phẩm</a>
                                <button type="button" class="dd-toggle" aria-label="Mở danh mục sản phẩm" aria-expanded="false">
                                    <svg class="ico"><use href="#i-chevron" /></svg>
                                </button>
                                <div class="dropdown-menu">
                                    <a href="Products.aspx?loai=leu">Lều cắm trại</a>
                                    <a href="Products.aspx?loai=den">Đèn chiếu sáng</a>
                                    <a href="Products.aspx?loai=ba-lo">Ba lô - túi</a>
                                    <a href="Products.aspx?loai=thiet-bi">Thiết bị cắm trại</a>
                                    <a href="Products.aspx?loai=xe-dap">Xe đạp</a>
                                </div>
                            </li>

                            <li class="nav-item"><a class="nav-link" href="Contact.aspx">Liên hệ</a></li>
                            <li class="nav-item"><a class="nav-link" href="Contact.aspx">Tin tức</a></li>
                        </ul>
                    </div>

                    <div class="drawer-foot">
                        <a href="tel:0987654321">0987654321</a><br />
                        <a href="mailto:hotro@Mycamp.vn">hotro@Mycamp.vn</a>
                    </div>
                </nav>
            </div>
        </header>

        <main>
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <footer class="site-footer">
            <div class="container">
                
            </div>
        </footer>
    </form>

    <%-- Danh sách sản phẩm lấy từ Application (Global.asax) --%>
    <script src="ProductsJs.ashx"></script>
    <script src="Content/shop.js"></script>
    <script src="Content/header.js"></script>
</body>
</html>
